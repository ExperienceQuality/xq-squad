{
  "$schema": "./schemas/squad-config.schema.json",
  "name": "xq-squad",
  "version": "1.0.3",
  "release_tag": "v1.0.3",
  "config_schema_version": "1.0.0",
  "memory_schema_version": "1.0.0",
  "repository": "https://github.com/ExperienceQuality/xq-squad",
  "description": "Repository-native Devin subagent squad for software delivery.",
  "components": {
    "agents": {
      "lead": {
        "path": "agents/lead.md",
        "description": "Main orchestrator. Run in parent Devin session, not as subagent.",
        "managed": true
      },
      "analyst": {
        "path": "agents/analyst.md",
        "devin_profile": "../.devin/agents/analyst.md",
        "description": "Repository discovery and impact analysis.",
        "managed": true
      },
      "implementer": {
        "path": "agents/implementer.md",
        "devin_profile": "../.devin/agents/implementer.md",
        "description": "Assigned code changes following conventions.",
        "managed": true
      },
      "tester": {
        "path": "agents/tester.md",
        "devin_profile": "../.devin/agents/tester.md",
        "description": "Relevant checks and test execution.",
        "managed": true
      },
      "reviewer": {
        "path": "agents/reviewer.md",
        "devin_profile": "../.devin/agents/reviewer.md",
        "description": "Change review and risk identification.",
        "managed": true
      },
      "memory-maintainer": {
        "path": "agents/memory-maintainer.md",
        "devin_profile": "../.devin/agents/memory-maintainer.md",
        "description": "Durable memory reconciliation and update.",
        "managed": true
      }
    },
    "skills": {
      "squad-delivery": {
        "path": "../.devin/skills/squad-delivery/SKILL.md",
        "description": "On-demand delivery workflow skill.",
        "managed": true
      }
    },
    "workflows": {
      "delivery": {
        "path": "workflows/delivery.md",
        "managed": true
      },
      "memory-maintenance": {
        "path": "workflows/memory-maintenance.md",
        "managed": true
      },
      "parallel-execution": {
        "path": "workflows/parallel-execution.md",
        "managed": true
      }
    },
    "schemas": {
      "squad-config": {
        "path": "schemas/squad-config.schema.json",
        "managed": true
      },
      "memory-record": {
        "path": "schemas/memory-record.schema.json",
        "managed": true
      }
    }
  },
  "ownership": {
    "upstream_managed": [
      ".devin/agents/**",
      ".devin/skills/**",
      ".devin/rules/**",
      ".squad/agents/**",
      ".squad/workflows/**",
      ".squad/schemas/**",
      ".squad/scripts/**",
      ".squad/README.md"
    ],
    "merge_managed": [
      "AGENTS.md",
      ".squad/squad.json",
      ".squad/install-state.json"
    ],
    "consumer_owned": [
      ".squad/MEMORY.md",
      ".squad/knowledge/**",
      ".squad/memory/**",
      ".devin/rules/local-*",
      ".devin/agents/local-*"
    ]
  }
}
