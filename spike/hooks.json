{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/xq-probe/probe.mjs sessionStart",
        "timeout": 30
      }
    ],
    "sessionEnd": [
      {
        "command": "node .cursor/xq-probe/probe.mjs sessionEnd",
        "timeout": 30
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/xq-probe/probe.mjs beforeSubmitPrompt",
        "timeout": 30
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/xq-probe/probe.mjs beforeShellExecution",
        "timeout": 30
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/xq-probe/probe.mjs preToolUse",
        "timeout": 30
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node .cursor/xq-probe/probe.mjs beforeMCPExecution",
        "timeout": 30
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/xq-probe/probe.mjs postToolUse",
        "timeout": 30
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node .cursor/xq-probe/probe.mjs postToolUseFailure",
        "timeout": 30
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/xq-probe/probe.mjs afterFileEdit",
        "timeout": 30
      }
    ],
    "afterShellExecution": [
      {
        "command": "node .cursor/xq-probe/probe.mjs afterShellExecution",
        "timeout": 30
      }
    ],
    "subagentStart": [
      {
        "command": "node .cursor/xq-probe/probe.mjs subagentStart",
        "timeout": 30
      }
    ],
    "subagentStop": [
      {
        "command": "node .cursor/xq-probe/probe.mjs subagentStop",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "node .cursor/xq-probe/probe.mjs stop",
        "timeout": 30
      }
    ]
  }
}
